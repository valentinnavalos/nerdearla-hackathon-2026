GEMINI_API_KEY=
ENGINE=live_translate
ADMIN_TOKEN=
DATA_DIR=./data
LIVE_TRANSLATE_MODEL=gemini-3.5-live-translate-preview
TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
KP_MODEL=gemini-3.1-flash-lite
MAX_CONCURRENT_LIVE=4
ROTATE_AFTER_S=540
QUOTA_LIVE_SESSIONS_PER_DAY=0
NOTEBOOKLM_ENABLED=0
# only with NOTEBOOKLM_ENABLED=1 (pip install -r requirements-notebooklm.txt):
# NOTEBOOKLM_AUTH_JSON=  (contents of storage_state.json from `notebooklm login`)
NOTEBOOKLM_STORAGE_PATH=
NOTEBOOKLM_AUDIO=1
NOTEBOOKLM_AUDIO_LANG=es
ASK_RATE_LIMIT=5
ASK_RATE_WINDOW_S=600
LOG_LEVEL=INFO
SEGMENT_IDLE_S=2.0

# fallback A / chunked (backend/engine/chunked.py, main_cli.py)
GEMINI_MODEL=gemini-2.5-flash
CHUNK_SECONDS=5
OVERLAP_SECONDS=0.75
REALTIME=1

# replay + demo room seeded at startup (until the operator console, T2.9)
REPLAY_FILE=samples/replay_demo.jsonl
DEMO_FILE=
DEMO_LANG=en
DEMO_LOOP=0
